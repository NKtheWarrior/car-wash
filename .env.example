# Copy to .env and fill in. Secrets live here; tunables live in the DB (Setting table).

# --- Database ---
DATABASE_URL="postgresql://carwash:carwash@127.0.0.1:5432/carwash?schema=public"

# --- MQTT broker (Mosquitto) ---
MQTT_URL="mqtt://127.0.0.1:1883"
MQTT_USERNAME="api"
MQTT_PASSWORD="api-secret"

# --- API ---
API_PORT=4000
# Public base URL of the API (used in UPI tn / links)
API_PUBLIC_URL="http://localhost:4000"
# Public base URL of the customer website (used to build QR scan URLs)
WEB_PUBLIC_URL="http://localhost:3000"
JWT_SECRET="change-me-in-production"
# Enables /dev/* routes (mock payment observation). NEVER enable in production.
ENABLE_DEV_ROUTES=true

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
