# Production env for docker-compose.prod.yml. Copy to `.env` on the VPS and fill in.
#   cp .env.production.example .env  &&  nano .env
# Hostnames here are DOCKER SERVICE NAMES (postgres, mosquitto) — not 127.0.0.1.

# --- Postgres (used by the postgres container AND the DATABASE_URL below) ---
POSTGRES_USER=carwash
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=carwash
DATABASE_URL="postgresql://carwash:CHANGE_ME_db_password@postgres:5432/carwash?schema=public"

# --- MQTT broker ---
MQTT_URL="mqtt://mosquitto:1883"
MQTT_USERNAME="api"
MQTT_PASSWORD="CHANGE_ME_api_mqtt_password"

# --- API ---
API_PORT=4000
# Public HTTPS URL of the API (its own subdomain). Used in UPI tn / links.
API_PUBLIC_URL="https://api.example.com"
# Public HTTPS URL of the customer website. Must match for CORS + QR links.
WEB_PUBLIC_URL="https://example.com"
# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET="CHANGE_ME_long_random_secret"
# MUST stay false in production (disables mock-payment /dev routes).
ENABLE_DEV_ROUTES=false

# --- Web (Next.js) — baked into the client bundle at build time ---
NEXT_PUBLIC_API_URL="https://api.example.com"
